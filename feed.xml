---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>Spek guides</title><link>{{ '/blog/' | absolute_url | xml_escape }}</link>
<description>Practical guides for everyday conversations across languages.</description><language>en</language>
<atom:link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml"/>
{% for post in site.posts limit:20 %}<item>
<title>{{ post.title | xml_escape }}</title><link>{{ post.url | absolute_url | xml_escape }}</link>
<guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
<pubDate>{{ post.date | date_to_rfc822 }}</pubDate><description>{{ post.description | xml_escape }}</description>
</item>{% endfor %}
</channel></rss>
